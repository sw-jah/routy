    try {
      await fetch('/api/places/sync', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'addPlace',
          roomCode: currentRoom.code,
          place: newPlace,
        }),
      });
