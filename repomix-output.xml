                                </a>
                                <a
                                  href={kakaoNaviUrl}
                                  target="_blank"
                                  rel="noreferrer"
                                  className="font-title flex-1 py-1.5 text-center text-[10px] bg-[#2D241E] text-[#F3D5B5] rounded-lg flex items-center justify-center gap-1"
